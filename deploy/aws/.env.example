# StudioSaaS AWS deployment environment — copy to deploy/aws/.env and fill in.
# NEVER commit the filled-in .env. On AWS prefer Secrets Manager / SSM Parameter
# Store and inject these at deploy time (see README_AWS.md §5).

# ── Required ────────────────────────────────────────────────────────────────
# RDS PostgreSQL 16 connection string (private subnet, EC2 security group only).
# sslmode=require is non-negotiable in production; use the least-privilege app
# role from README_AWS.md §2, never the RDS master user.
STUDIOSAAS_DATABASE_URL=postgresql://studiosaas_app:CHANGE_ME@your-rds-host.ap-southeast-2.rds.amazonaws.com:5432/studiosaas?sslmode=require

# Two DIFFERENT strong random values (openssl rand -hex 32). Startup refuses
# to boot in production if either is missing or if they are equal.
STUDIOSAAS_SESSION_SECRET=
STUDIOSAAS_API_KEY=

# ── Recommended ─────────────────────────────────────────────────────────────
STUDIOSAAS_ENV=production
STUDIOSAAS_PUBLIC_BASE_DOMAIN=pwestudio.online

# Email delivery — leave console (log-only) until SES is verified, then:
#STUDIOSAAS_EMAIL_BACKEND=smtp
#STUDIOSAAS_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
#STUDIOSAAS_SMTP_PORT=587
#STUDIOSAAS_SMTP_USER=
#STUDIOSAAS_SMTP_PASSWORD=
#STUDIOSAAS_SMTP_FROM=noreply@studiosaas.cc.cd

# DB wait ceilings (defaults shown) and the support-gate kill switch
#STUDIOSAAS_DB_CONNECT_TIMEOUT=5
#STUDIOSAAS_DB_STATEMENT_TIMEOUT_MS=30000
#STUDIOSAAS_DB_LOCK_TIMEOUT_MS=10000
#STUDIOSAAS_ENFORCE_SUPPORT_GATE=1

# Image tag written by build_aws_bundle.sh (informational)
STUDIOSAAS_VERSION=latest

# ── One-time bootstrap ──────────────────────────────────────────────────────
# Set to 1 for the FIRST boot only, to create the platform super admin, then
# set back to 0 and rotate the credential with rotate_pilot_credentials.py.
STUDIOSAAS_SEED_SUPER_ADMIN=0

# ── Single-instance Lightsail profile ───────────────────────────────────────
# Used only with docker-compose.lightsail.yml. Generate independent hex values
# so they are URL-safe and at least 32 characters:
#   openssl rand -hex 32
#   openssl rand -hex 32
#LOCAL_DB_PASSWORD=
#LOCAL_APP_DB_PASSWORD=
#STUDIOSAAS_BACKUP_DIR=/opt/pwestudio/backups/postgres
