# PWE Studio v9.1.1 — pwestudio.online single-instance Lightsail
# Copy to /opt/pwestudio/shared/production.env, replace every CHANGE_ME and
# chmod 600. Never commit the completed file.

STUDIOSAAS_ENV=production
STUDIOSAAS_VERSION=9.1.1
STUDIOSAAS_PUBLIC_BASE_DOMAIN=pwestudio.online
STUDIOSAAS_SESSION_SECRET=CHANGE_ME_64_HEX
STUDIOSAAS_API_KEY=CHANGE_ME_DIFFERENT_64_HEX
STUDIOSAAS_SEED_SUPER_ADMIN=0

# PostgreSQL owner and least-privilege application role. Use two different
# values from `openssl rand -hex 32`; hex avoids URL-encoding ambiguity.
LOCAL_DB_PASSWORD=CHANGE_ME_64_HEX
LOCAL_APP_DB_PASSWORD=CHANGE_ME_DIFFERENT_64_HEX

STUDIOSAAS_BACKUP_DIR=/opt/pwestudio/backups/postgres

# Until SES is configured, console means log-only delivery.
STUDIOSAAS_EMAIL_BACKEND=console
STUDIOSAAS_ENFORCE_SUPPORT_GATE=1

# ── 数据库角色分离（v10.3.0 起）────────────────────────────────────
#
# 应用与迁移用两个不同的角色，理由是 RLS：**超级用户无条件绕过行级安全**，
# 表属主默认也绕过。以属主身份连库，等于策略在库里躺着、隔离为零 ——
# 这一点在本地实测过，两个租户的数据照样全读得到。
#
#   STUDIOSAAS_MIGRATION_DATABASE_URL  属主。跑迁移与后台脚本（建表、改约束、
#                                      演示重置、媒体派生回填）。
#   STUDIOSAAS_DATABASE_URL            受限角色 studiosaas_app。Web 应用只用它。
#                                      它不拥有任何表、不是超级用户、没有
#                                      CREATE/DROP/TRUNCATE/ALTER。
#
# 迁移 0042 会建好角色（NOLOGIN，无密码）。密码由运维设一次，不进 git：
#
#   ALTER ROLE studiosaas_app LOGIN PASSWORD '<强密码>';
#
# 切换顺序（每步可独立回滚）：
#   1. 部署带 0042 的版本 —— 策略建好但**不生效**，因为应用仍以属主连接。
#      这一步行为零变化，是观察窗。
#   2. 设 STUDIOSAAS_MIGRATION_DATABASE_URL 为当前的属主连接串。
#   3. 设密码，把 STUDIOSAAS_DATABASE_URL 换成 studiosaas_app。重启。
#   4. 验证：登录、公开站、账单、超管控制台各走一遍。
#
# 回滚就是把 STUDIOSAAS_DATABASE_URL 改回属主连接串再重启 —— 策略还在，
# 只是又不生效了，和第 1 步一样。
#
#STUDIOSAAS_MIGRATION_DATABASE_URL=postgresql://studiosaas:...@db:5432/studiosaas
#STUDIOSAAS_DATABASE_URL=postgresql://studiosaas_app:...@db:5432/studiosaas
