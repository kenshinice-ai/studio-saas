# ── macOS / iCloud artifacts ──
__MACOSX/
.DS_Store
*.swp
*~

# ── Python ──
*.pyc
__pycache__/
*.pyo
*.egg-info/
dist/
outputs/
build/

# ── Virtual environment ──
.venv/
venv/

# ── StudioSaaS local secrets (NEVER commit) ──
.runtime/
*.pem
deploy/aws/.env
backend/.api_secret
backend/.session_secret
backend/.cms_password
backend/.cms_config.json
backend/database.json
backend/backups/
backups/
backend/photos/
backend/portfolio/
backend/static/uploads/
backend/media/
backend/archives/

# ── Checkpoint archives ──
checkpoints/

# ── Local packaging artefacts ──
*.zip
achieve/

# ── Local repair backups ──
*.bak
*.bak.*
*.backup

# ── Local test artifacts ──
cms_test_*/
test_*/

# ── OS generated ──
Thumbs.db
ehthumbs.db

# Office/LibreOffice lock files
~$*

# PWE Studio Edition install-time artefacts (never committed).
# The .env IS every secret on a customer box; `backups/` is already ignored
# above and is where the Edition's host bind mount lands.
standalone-edition/.env
standalone-edition/.env.bak

# Agent tooling mirrors .claude/skills into .agents/ at runtime. It is a copy
# of tracked content, and left untracked it fails the clean-tree gate in
# deploy/aws/build_aws_bundle.sh.
.agents/
.venv

# Workspaces created by backend/test_tenant_isolation.py. They are fixtures of
# a test run, not tenants, and a release bundle must not carry them.
tenants/isolation-*/
tenants/test-*/

# Client proposals. This repository is PUBLIC, and a proposal names the
# prospect, quotes them a price we told them was theirs, and shows our own
# cost structure. `docs/sales/` keeps its marketing material — the roadshow
# deck and the WeChat ads are meant to be seen — but anything written FOR a
# named client lives under clients/ and never leaves this machine.
#
# Structural on purpose: the rule is the directory, so it cannot be forgotten
# by whoever writes the next one.
docs/sales/clients/
