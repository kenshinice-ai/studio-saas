# Docker build context excludes — keep the image to runtime code + generated
# tenant workspaces. Mirrors package_release.sh exclusions.
.git
.gitignore
.DS_Store
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
**/.pytest_cache

# Local mutable state — never bake into an image
backend/database.json
backend/backups
backend/photos
backend/portfolio
backend/media
backend/archives
backend/.api_secret
backend/.session_secret
backend/.cms_password
backups
checkpoints
dist

# Dev-only
backend/testdata
.claude
deploy/aws/.env

# Nothing below is read at runtime. The image carried the whole design-source
# tree and the test suite because the exclusions were written per-file as they
# became a problem rather than from "what does the server actually open".
# customer-resources/ and legacy-root/ ARE served — do not add them here.
docs
01 BRAND ASSETS
backend/tests
backend/test_tenant_isolation.py
standalone-edition
.agents
